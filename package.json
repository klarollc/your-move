{
  "name": "cuckcode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "fixtures/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @cuckcode/web",
    "dev:server": "npm run dev --workspace @cuckcode/server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "roles:agency-agents:import": "node scripts/import-agency-agents.mjs",
    "roles:agency-agents:check": "node scripts/check-agency-agents.mjs",
    "test:roles": "node --test scripts/agency-agents-import.test.mjs && npm run roles:agency-agents:check",
    "protocol:codex:generate": "node scripts/generate-codex-protocol.mjs",
    "protocol:codex:check": "node scripts/check-codex-protocol.mjs",
    "test:protocol": "node --test scripts/protocol-codex.test.mjs && npm run protocol:codex:check",
    "test:scaffold": "node --test scripts/scaffold-contract.test.mjs",
    "test:qualification": "vitest run --project unit packages/testing/src/qualification.unit.test.ts",
    "test:runtime": "vitest run --project contract packages/contracts/src/runtime.contract.test.ts packages/testing/src/runtime-fake.contract.test.ts && vitest run --project integration packages/runtime-codex/src/supervisor.integration.test.ts && vitest run --project unit packages/runtime-codex/src/normalizer.unit.test.ts packages/domain/src/runtime-controls.unit.test.ts",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:contract": "vitest run --project contract --passWithNoTests",
    "test:e2e": "playwright test --grep @e2e --project chromium-1440 --project chromium-1280",
    "test:a11y": "playwright test --grep @a11y --project chromium-1440 --project chromium-1280",
    "test:visual": "playwright test --grep @visual --pass-with-no-tests --project chromium-1440 --project chromium-1280",
    "build": "npm run typecheck && npm run build --workspace @cuckcode/web",
    "verify": "npm run test:protocol && npm run test:roles && npm run test:qualification && npm run test:scaffold && npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:contract && npm run build && npm run test:e2e && npm run test:a11y && npm run test:visual"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
