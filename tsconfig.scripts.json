{
  // scripts/ is not in the tsconfig.json project graph, so `npm run typecheck` has never covered a
  // single file in it — every Phase 5 builder, guard and brief is unchecked. It was found on
  // 2026-09-14 when a duplicate `const` in the release brief passed both lint and typecheck and was
  // caught only by esbuild at runtime.
  //
  // Wired into `npm run verify` on 2026-09-14, immediately after `typecheck`, once the two
  // pre-existing errors it reported were ruled on and fixed: the dropped `roleId` in
  // `run-phase4-kickoff.ts` and the `exactOptionalPropertyTypes` violation in
  // `build-phase6-golden-states.ts`. Both were in completed phases and neither was touched before
  // the ruling, which is recorded in
  // `docs/evidence/decision-record-2026-09-14-scripts-typecheck.md`. It was held out of `verify`
  // until then because a gate that is switched on with known failures is not a gate.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts"]
}
