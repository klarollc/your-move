{
  "schema": "cuckcode.agent-runner-allowlist.v1",
  "note": "Every command an agent may request through scripts/agent-runner.mjs. Requests carry no arguments. Changing this file is a governed change: scripts/agent-runner.test.mjs checks every entry against package.json.",
  "commands": {
    "verify": { "kind": "npm", "script": "verify" },
    "typecheck": { "kind": "npm", "script": "typecheck" },
    "typecheck:scripts": { "kind": "npm", "script": "typecheck:scripts" },
    "format:check": { "kind": "npm", "script": "format:check" },
    "lint": { "kind": "npm", "script": "lint" },
    "test:unit": { "kind": "npm", "script": "test:unit" },
    "test:component": { "kind": "npm", "script": "test:component" },
    "test:contract": { "kind": "npm", "script": "test:contract" },
    "test:integration": { "kind": "npm", "script": "test:integration" },
    "test:e2e": { "kind": "npm", "script": "test:e2e" },
    "test:a11y": { "kind": "npm", "script": "test:a11y" },
    "test:visual": { "kind": "npm", "script": "test:visual" },
    "phase5:provenance": { "kind": "npm", "script": "phase5:provenance" },
    "git-status": { "kind": "git", "args": ["status", "--porcelain=v1", "--branch"] },
    "git-push": {
      "kind": "git",
      "args": ["push", "origin", "{branch}", "main"],
      "requires": "allow-push"
    }
  }
}
